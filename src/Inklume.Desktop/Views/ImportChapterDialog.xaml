<ui:FluentWindow x:Class="Inklume.Desktop.Views.ImportChapterDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Import Chapter"
                 Width="540" Height="430"
                 MinWidth="480" MinHeight="380"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Import Chapter" ShowMinimize="False" ShowMaximize="False"
                     Background="{DynamicResource TopBarBackgroundBrush}"
                     ButtonsBackground="Transparent"
                     ButtonsForeground="{DynamicResource TextPrimaryBrush}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,22,26,16">
            <StackPanel>
                <TextBlock Text="Import Chapter" Style="{DynamicResource PageTitleTextStyle}" FontSize="20" />
                <TextBlock Text="Select a local folder containing images to add as a chapter."
                           Style="{DynamicResource SecondaryTextStyle}" Margin="0,6,0,20" />

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Chapter number"
                                   FontWeight="Medium"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,6" />
                        <ui:TextBox Text="{Binding ChapterNumber, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="e.g. 1"
                                    AutomationProperties.Name="Chapter number" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Title (optional)"
                                   FontWeight="Medium"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,6" />
                        <ui:TextBox Text="{Binding ChapterTitle, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="e.g. A New Beginning"
                                    AutomationProperties.Name="Chapter title" />
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Source folder"
                               FontWeight="Medium"
                               FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding SourceFolder, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Path to images directory..."
                                    AutomationProperties.Name="Chapter source folder" />
                        <ui:Button Grid.Column="1"
                                   Content="Browse..."
                                   Icon="{ui:SymbolIcon FolderOpen24}"
                                   Appearance="Secondary"
                                   Command="{Binding BrowseCommand}"
                                   Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock Text="Supported formats: PNG · JPG · JPEG · WebP"
                               Style="{DynamicResource CaptionTextStyle}"
                               Margin="0,6,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource PanelBackgroundBrush}"
                Padding="20,12">
            <Grid>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource ErrorBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,180,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Cancel"
                               Command="{Binding CancelCommand}"
                               Appearance="Secondary"
                               MinWidth="86"
                               Margin="0,0,8,0" />
                    <ui:Button Content="Import"
                               Command="{Binding ImportCommand}"
                               Appearance="Primary"
                               TextElement.Foreground="{DynamicResource TextOnAccentBrush}"
                               FontWeight="SemiBold"
                               IsDefault="True"
                               MinWidth="86" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
