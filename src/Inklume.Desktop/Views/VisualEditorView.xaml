<UserControl x:Class="Inklume.Desktop.Views.VisualEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:editor="clr-namespace:Inklume.Desktop.VisualEditor"
             Focusable="True"
             FocusManager.IsFocusScope="True"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <Grid Background="{DynamicResource EditorBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource TopBarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Content="Select"
                                 Style="{DynamicResource EditorToolButtonStyle}"
                                 IsChecked="{Binding SelectedTool, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static editor:VisualEditorTool.Select}}"
                                 Command="{Binding SelectToolCommand}" />
                    <RadioButton Content="Rectangle"
                                 Style="{DynamicResource EditorToolButtonStyle}"
                                 IsEnabled="{Binding IsEditingEnabled}"
                                 IsChecked="{Binding SelectedTool, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static editor:VisualEditorTool.RectangleRegion}}"
                                 Command="{Binding RectangleToolCommand}" />
                    <RadioButton Content="Polygon"
                                 Style="{DynamicResource EditorToolButtonStyle}"
                                 IsEnabled="{Binding IsEditingEnabled}"
                                 IsChecked="{Binding SelectedTool, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static editor:VisualEditorTool.PolygonRegion}}"
                                 Command="{Binding PolygonToolCommand}" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="RAW VISUAL EDITOR"
                               Style="{DynamicResource CaptionTextStyle}"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Read-only image preview"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGenericPreview}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="Run OCR"
                               Appearance="Secondary"
                               Command="{Binding RunPageOcrCommand}"
                               ToolTip="Detect and recognize text on the current page"
                               Padding="10,2"
                               MinHeight="26"
                               Margin="0,0,6,0" />
                    <ui:Button Content="Fit"
                               Appearance="Transparent"
                               Command="{Binding FitToViewCommand}"
                               ToolTip="Fit page to viewport"
                               Padding="9,2"
                               MinHeight="26" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="Viewport"
              Grid.Row="1"
              ClipToBounds="True"
              Focusable="True"
              Background="{DynamicResource EditorBackgroundBrush}"
              SizeChanged="OnViewportSizeChanged"
              PreviewMouseDown="OnViewportMouseDown"
              PreviewMouseMove="OnViewportMouseMove"
              PreviewMouseUp="OnViewportMouseUp"
              PreviewMouseWheel="OnViewportMouseWheel"
              PreviewKeyDown="OnViewportKeyDown"
              PreviewKeyUp="OnViewportKeyUp">
            <Canvas ClipToBounds="False">
                <Grid x:Name="World"
                      Width="{Binding ImageWidth}"
                      Height="{Binding ImageHeight}"
                      RenderTransformOrigin="0,0">
                    <Grid.RenderTransform>
                        <MatrixTransform x:Name="WorldTransform" />
                    </Grid.RenderTransform>
                    <Border Background="White">
                        <Image x:Name="PageImage"
                               Source="{Binding PreviewImage}"
                               Width="{Binding ImageWidth}"
                               Height="{Binding ImageHeight}"
                               Stretch="Fill"
                               AutomationProperties.Name="Selected RAW page" />
                    </Border>
                    <Canvas x:Name="OverlayCanvas"
                            Width="{Binding ImageWidth}"
                            Height="{Binding ImageHeight}"
                            Background="Transparent" />
                </Grid>
            </Canvas>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasPreview}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ui:SymbolIcon Symbol="Image24" FontSize="28"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" />
                <TextBlock Text="No page selected" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,10,0,0" />
                <TextBlock Text="Choose a page in Project Explorer to begin editing regions."
                           Style="{DynamicResource SecondaryTextStyle}"
                           HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>

            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="18"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    CornerRadius="{StaticResource CornerMedium}" MaxWidth="420">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}"
                           TextWrapping="Wrap" TextAlignment="Center" />
            </Border>

            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20,16"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerMedium}" MinWidth="260">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOcrRunning}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,12" Width="200" />
                    <TextBlock Text="{Binding OcrProgressMessage}"
                               Style="{DynamicResource CaptionTextStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10" />
                    <ui:Button Content="Cancel"
                               Appearance="Secondary"
                               Command="{Binding CancelOcrCommand}"
                               HorizontalAlignment="Center"
                               Padding="14,2"
                               MinHeight="24" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
