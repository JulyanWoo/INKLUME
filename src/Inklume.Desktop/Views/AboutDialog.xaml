<ui:FluentWindow x:Class="Inklume.Desktop.Views.AboutDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="About INKLUME"
                  Width="430" SizeToContent="Height"
                  ResizeMode="NoResize" ShowInTaskbar="False"
                  WindowStartupLocation="CenterOwner"
                  WindowBackdropType="None"
                  ExtendsContentIntoTitleBar="True"
                  Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="About INKLUME" ShowMinimize="False" ShowMaximize="False"
                     Background="{DynamicResource TopBarBackgroundBrush}"
                     ButtonsBackground="Transparent"
                     ButtonsForeground="{DynamicResource TextPrimaryBrush}" />
        <StackPanel Grid.Row="1" Margin="28,24" HorizontalAlignment="Center">
            <TextBlock Text="{Binding ApplicationName}" FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Subtitle}" Style="{DynamicResource SecondaryTextStyle}"
                       Margin="0,7,0,0" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Version, StringFormat=Version {0}}"
                       Style="{DynamicResource CaptionTextStyle}" Margin="0,14,0,22"
                       HorizontalAlignment="Center" />
            <ui:Button Content="Close" Command="{Binding CloseCommand}" MinWidth="90" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
