<Window x:Class="Inklume.Desktop.Views.NewProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Project"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Create a localization project" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="Choose a name and an empty folder for the new INKLUME workspace."
                       Style="{StaticResource SecondaryTextStyle}" Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="Project name" Margin="0,0,0,6" />
            <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Project name" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="Series name" Margin="0,0,0,6" />
            <TextBox Text="{Binding SeriesName, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Series name" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,18">
            <TextBlock Text="Project folder" Margin="0,0,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding ProjectFolder, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Project folder" />
                <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
            </Grid>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                       TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="90" Margin="0,0,8,0" />
            <Button Content="Create" Command="{Binding CreateCommand}" Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True" MinWidth="90" />
        </StackPanel>
    </Grid>
</Window>
