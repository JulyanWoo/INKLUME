<ui:FluentWindow x:Class="Inklume.Desktop.Views.NewProjectDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="New Project"
                 Width="560" Height="470"
                 MinWidth="500" MinHeight="420"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="New Project" ShowMinimize="False" ShowMaximize="False"
                     Background="{DynamicResource TopBarBackgroundBrush}"
                     ButtonsBackground="Transparent"
                     ButtonsForeground="{DynamicResource TextPrimaryBrush}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,22,26,16">
            <StackPanel>
                <TextBlock Text="Create a localization project" Style="{DynamicResource PageTitleTextStyle}" FontSize="20" />
                <TextBlock Text="Choose a name and a source folder for the new INKLUME workspace."
                           Style="{DynamicResource SecondaryTextStyle}" Margin="0,6,0,4" />
                <TextBlock Text="INKLUME keeps workspace metadata outside your source folder."
                           Style="{DynamicResource CaptionTextStyle}" Margin="0,0,0,20" />

                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Project name"
                               FontWeight="Medium"
                               FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,6" />
                    <ui:TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="e.g. My Comic"
                                AutomationProperties.Name="Project name" />
                </StackPanel>

                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Series name"
                               FontWeight="Medium"
                               FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,6" />
                    <ui:TextBox Text="{Binding SeriesName, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="e.g. Volume 1"
                                AutomationProperties.Name="Series name" />
                </StackPanel>

                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Source folder"
                               FontWeight="Medium"
                               FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding ProjectFolder, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Path to comic source folder..."
                                    AutomationProperties.Name="Source folder" />
                        <ui:Button Grid.Column="1"
                                   Content="Browse..."
                                   Icon="{ui:SymbolIcon FolderOpen24}"
                                   Appearance="Secondary"
                                   Command="{Binding BrowseCommand}"
                                   Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource PanelBackgroundBrush}"
                Padding="20,12">
            <Grid>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource ErrorBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,180,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Cancel"
                               Command="{Binding CancelCommand}"
                               Appearance="Secondary"
                               MinWidth="86"
                               Margin="0,0,8,0" />
                    <ui:Button Content="Create"
                               Command="{Binding CreateCommand}"
                               Appearance="Primary"
                               TextElement.Foreground="{DynamicResource TextOnAccentBrush}"
                               FontWeight="SemiBold"
                               IsDefault="True"
                               MinWidth="86" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
