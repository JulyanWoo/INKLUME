<UserControl x:Class="Inklume.Desktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="290" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="18,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ui:Button Content="New Project" Icon="{ui:SymbolIcon Add24}"
                           Command="{Binding NewProjectCommand}" Appearance="Primary"
                           Style="{DynamicResource SidebarActionButtonStyle}" Margin="0,0,0,10" />
                <ui:Button Grid.Row="1" Content="Open Project" Icon="{ui:SymbolIcon FolderOpen24}"
                           Command="{Binding OpenProjectCommand}" Appearance="Secondary"
                           Style="{DynamicResource SidebarActionButtonStyle}" />
                <StackPanel Grid.Row="2" Margin="0,30,0,0">
                    <TextBlock Text="WORKSPACE" Style="{DynamicResource CaptionTextStyle}" Margin="6,0,0,8" />
                    <ui:Button Content="Dashboard" Icon="{ui:SymbolIcon Home24}"
                               Style="{DynamicResource SelectedSidebarButtonStyle}" />
                </StackPanel>
                <ui:Button Grid.Row="3" Content="Settings" Icon="{ui:SymbolIcon Settings24}"
                           Command="{Binding OpenSettingsCommand}"
                           Appearance="Transparent"
                           Style="{DynamicResource SidebarActionButtonStyle}" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,24">
                <!-- Error notification banner when a project operation fails -->
                <Border Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource ErrorBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16,12"
                        Margin="0,0,0,18">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasErrorMessage}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="DismissCircle24" Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13" />
                        <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Dismiss16}" Appearance="Transparent"
                                   Command="{Binding DismissErrorCommand}" ToolTip="Dismiss" Margin="10,0,0,0" Padding="4" MinHeight="22" />
                    </Grid>
                </Border>

                <Border Style="{DynamicResource PanelBorderStyle}" Padding="24" Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="2" />
                        <StackPanel Grid.Column="1" Margin="18,0,0,0">
                            <TextBlock FontSize="26" FontWeight="SemiBold">
                                <Run Text="Welcome to " Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Run Text="INKLUME" Foreground="{DynamicResource AccentBrush}" />
                            </TextBlock>
                            <TextBlock Text="AI Comic Localization Studio" FontSize="16"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0" />
                            <TextBlock Text="Create a workspace or open an existing project to organize local comic chapters."
                                       Style="{DynamicResource SecondaryTextStyle}" Margin="0,5,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <DockPanel Margin="0,0,0,12">
                    <TextBlock Text="Recent Projects" Style="{DynamicResource SectionTitleTextStyle}" />
                    <TextBlock DockPanel.Dock="Right" Text="Current session" Style="{DynamicResource CaptionTextStyle}"
                               HorizontalAlignment="Right" />
                </DockPanel>

                <Border Style="{DynamicResource PanelBorderStyle}" Padding="28" MinHeight="210">
                    <Grid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasRecentProjects}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="No recent projects" FontSize="17" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Create or open a project to get started."
                                       Style="{DynamicResource SecondaryTextStyle}" Margin="0,6,0,0" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding RecentProjects}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Button Width="250" MinHeight="138" Margin="0,0,12,12" Padding="0"
                                               Appearance="Secondary"
                                               HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                               Command="{Binding DataContext.OpenRecentProjectCommand,
                                                   RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}">
                                        <Grid Margin="16">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="1" Text="{Binding SeriesName}"
                                                       Style="{DynamicResource SecondaryTextStyle}" Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="2" Text="{Binding RootPath}"
                                                       Style="{DynamicResource CaptionTextStyle}" Margin="0,14,0,0"
                                                       TextWrapping="Wrap" MaxHeight="34" />
                                            <TextBlock Grid.Row="3" Text="Opened this session"
                                                       Style="{DynamicResource CaptionTextStyle}" Margin="0,10,0,0" />
                                        </Grid>
                                    </ui:Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="2" Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
            <StackPanel Margin="18,24">
                <TextBlock Text="Getting Started" Style="{DynamicResource SectionTitleTextStyle}" Margin="0,0,0,14" />
                <Border Style="{DynamicResource PanelBorderStyle}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Create a project" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Choose a local folder and define the project and series names."
                                   Style="{DynamicResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource PanelBorderStyle}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Open an existing workspace" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Select a valid INKLUME project folder to continue working."
                                   Style="{DynamicResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource PanelBorderStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Local and private" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Project metadata and imported chapter images remain in the selected workspace."
                                   Style="{DynamicResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
