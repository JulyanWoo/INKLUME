<UserControl x:Class="Inklume.Desktop.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:Inklume.Desktop.Views"
             xmlns:viewModels="clr-namespace:Inklume.Desktop.ViewModels">
    <UserControl.Resources>
        <HierarchicalDataTemplate DataType="{x:Type viewModels:ProjectExplorerNode}"
                                  ItemsSource="{Binding Children}"
                                  ItemContainerStyle="{StaticResource ProjectExplorerItemStyle}">
            <Border CornerRadius="3"
                    Padding="4,3"
                    Margin="1,0"
                    HorizontalAlignment="Stretch">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                    <Condition Binding="{Binding IsSelected}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}" />
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding IsChapterCandidate}" Value="True">
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu>
                                            <MenuItem Header="Import as Chapter..."
                                                      Command="{Binding DataContext.ImportChapterWithFolderCommand, RelativeSource={RelativeSource AncestorType=views:WorkspaceView}}"
                                                      CommandParameter="{Binding FullPath}" />
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasLooseImages}" Value="True">
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu>
                                            <MenuItem Header="Import loose images as chapter..."
                                                      Command="{Binding DataContext.ImportChapterWithFolderCommand, RelativeSource={RelativeSource AncestorType=views:WorkspaceView}}"
                                                      CommandParameter="{Binding FullPath}" />
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="2" Height="16" CornerRadius="1"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource AccentBrush}"
                            Visibility="{Binding IsSelected,
                            Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ui:SymbolIcon Grid.Column="1" Style="{DynamicResource ProjectExplorerIconStyle}"
                                   VerticalAlignment="Center" />
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DisplayName}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding DisplayName}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SecondaryText}"
                                   Margin="6,0,0,0"
                                   Style="{DynamicResource CaptionTextStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252" MinWidth="210" />
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="284" MinWidth="230" />
            </Grid.ColumnDefinitions>

            <Grid Background="{DynamicResource SidebarBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="12,0,6,0">
                        <TextBlock Text="PROJECT EXPLORER" Style="{DynamicResource CaptionTextStyle}"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ui:Button HorizontalAlignment="Right"
                                   Style="{DynamicResource ToolbarButtonStyle}"
                                   Icon="{ui:SymbolIcon FolderAdd24}"
                                   Command="{Binding ImportChapterCommand}"
                                   ToolTip="Import chapter" />
                    </Grid>
                </Border>
                <Grid Grid.Row="1">
                    <TreeView x:Name="ProjectExplorer"
                              ItemsSource="{Binding ExplorerRoots}"
                              ItemContainerStyle="{StaticResource ProjectExplorerItemStyle}"
                              SelectedItemChanged="OnExplorerSelectionChanged"
                              PreviewMouseDown="OnProjectExplorerPreviewMouseDown"
                              PreviewMouseDoubleClick="OnProjectExplorerPreviewMouseDoubleClick"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              Background="Transparent" BorderThickness="0" Padding="5"
                              AutomationProperties.Name="Project explorer" />
                    <StackPanel Margin="18,0,18,20" VerticalAlignment="Bottom">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasChapters}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="No chapters imported" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Use Import Chapter to add a local image folder."
                                   Style="{DynamicResource CaptionTextStyle}" TextWrapping="Wrap"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" ResizeDirection="Columns" />

            <views:VisualEditorView Grid.Column="2" DataContext="{Binding VisualEditor}" />

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" ResizeDirection="Columns" />

            <Grid Grid.Column="4" Background="{DynamicResource PanelBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="INSPECTOR" Style="{DynamicResource CaptionTextStyle}"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0" />
                </Border>
                <Grid Grid.Row="1" Margin="16,14">
                    <!-- Canonical Page Inspector -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedPage}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding VisualEditor.HasSelectedRegion}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Page" Style="{DynamicResource SectionTitleTextStyle}" Margin="0,0,0,16" />
                        <TextBlock Text="Chapter" Style="{DynamicResource CaptionTextStyle}" />
                        <TextBlock Text="{Binding SelectedChapterNumber}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,11" />
                        <TextBlock Text="Page order" Style="{DynamicResource CaptionTextStyle}" />
                        <TextBlock Text="{Binding SelectedPageNumber}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,11" />
                        <TextBlock Text="RAW dimensions" Style="{DynamicResource CaptionTextStyle}" />
                        <TextBlock Text="{Binding SelectedPixelDimensions}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,11" />
                        <TextBlock Text="Original file" Style="{DynamicResource CaptionTextStyle}" />
                        <TextBlock Text="{Binding SelectedOriginalFileName}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,11" TextWrapping="Wrap" />
                        <TextBlock Text="Internal file" Style="{DynamicResource CaptionTextStyle}" />
                        <TextBlock Text="{Binding SelectedInternalFileName}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,11" TextWrapping="Wrap" />
                        <TextBlock Text="Relative path" Style="{DynamicResource CaptionTextStyle}" />
                        <TextBlock Text="{Binding SelectedRelativePath}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,11" TextWrapping="Wrap" />
                        <TextBlock Text="SHA-256" Style="{DynamicResource CaptionTextStyle}" />
                        <TextBlock Text="{Binding SelectedContentHash}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,11"
                                   FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Generic Image Inspector -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedGenericImage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding VisualEditor.HasSelectedRegion}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Image File" Style="{DynamicResource SectionTitleTextStyle}" Margin="0,0,0,8" />
                        <Border Background="{DynamicResource CardHoverBackgroundBrush}" CornerRadius="3" Padding="6,3" Margin="0,0,0,14" HorizontalAlignment="Left">
                            <TextBlock Text="Not imported (Read-only)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        <TextBlock Text="File name" Style="{DynamicResource CaptionTextStyle}" />
                        <TextBlock Text="{Binding SelectedGenericImageFileName}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,11" TextWrapping="Wrap" />
                        <TextBlock Text="Relative path" Style="{DynamicResource CaptionTextStyle}" />
                        <TextBlock Text="{Binding SelectedGenericImageRelativePath}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,11" TextWrapping="Wrap" />
                        <TextBlock Text="Extension" Style="{DynamicResource CaptionTextStyle}" />
                        <TextBlock Text="{Binding SelectedGenericImageExtension}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,11" />
                        <TextBlock Text="Pixel dimensions" Style="{DynamicResource CaptionTextStyle}" />
                        <TextBlock Text="{Binding SelectedGenericImageDimensions}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,11" />
                        <TextBlock Text="File size" Style="{DynamicResource CaptionTextStyle}" />
                        <TextBlock Text="{Binding SelectedGenericImageFileSize}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,11" />
                    </StackPanel>

                    <!-- Text Region Inspector -->
                    <!-- Text Region Inspector -->
                    <StackPanel DataContext="{Binding VisualEditor.Review}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedRegion}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Text Region" Style="{DynamicResource SectionTitleTextStyle}" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Background="{DynamicResource CardHoverBackgroundBrush}" CornerRadius="3" Padding="6,2">
                                <TextBlock Text="{Binding PageReviewProgressDisplay}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </Grid>

                        <!-- Reading order navigation and move -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:Button Content="◀ Prev" Appearance="Secondary" Command="{Binding SelectPreviousRegionCommand}" ToolTip="Previous region in reading order" Margin="0,0,4,0" Padding="8,4" />
                            <ui:Button Content="Next ▶" Appearance="Secondary" Command="{Binding SelectNextRegionCommand}" ToolTip="Next region in reading order" Margin="0,0,6,0" Padding="8,4" />
                            <ui:Button Content="▲ Move Up" Appearance="Secondary" Command="{Binding MoveUpCommand}" ToolTip="Move up in reading order" Margin="0,0,4,0" Padding="8,4" />
                            <ui:Button Content="▼ Move Down" Appearance="Secondary" Command="{Binding MoveDownCommand}" ToolTip="Move down in reading order" Padding="8,4" />
                        </StackPanel>

                        <!-- Region Metadata -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Reading order" Style="{DynamicResource CaptionTextStyle}" />
                                <TextBlock Text="{Binding ReadingOrder}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Origin" Style="{DynamicResource CaptionTextStyle}" />
                                <TextBlock Text="{Binding OriginDisplay}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Bounds (x, y, w x h)" Style="{DynamicResource CaptionTextStyle}" />
                        <TextBlock Text="{Binding BoundsDisplay}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,8" TextWrapping="Wrap" />

                        <TextBlock Text="Role" Style="{DynamicResource CaptionTextStyle}" />
                        <ComboBox x:Name="RegionRoleSelector"
                                  ItemsSource="{Binding Roles}"
                                  SelectedItem="{Binding SelectedRegion.Role, Mode=OneWay}"
                                  SelectionChanged="OnRegionClassificationChanged"
                                  Margin="0,3,0,8" />

                        <TextBlock Text="Container type" Style="{DynamicResource CaptionTextStyle}" />
                        <ComboBox x:Name="RegionContainerSelector"
                                  ItemsSource="{Binding ContainerTypes}"
                                  SelectedItem="{Binding SelectedRegion.ContainerType, Mode=OneWay}"
                                  SelectionChanged="OnRegionClassificationChanged"
                                  Margin="0,3,0,10" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:Button Content="Recognize Region"
                                       Appearance="Secondary"
                                       Command="{Binding RecognizeRegionCommand}"
                                       ToolTip="Recognize text in this region with OCR"
                                       Margin="0,0,6,0" />
                            <ui:Button Content="Delete Region"
                                       Appearance="Secondary"
                                       Command="{Binding DataContext.VisualEditor.DeleteSelectedRegionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </StackPanel>

                        <!-- SOURCE TEXT REVIEW (Part E) -->
                        <Border Background="{DynamicResource CardHoverBackgroundBrush}"
                                CornerRadius="{StaticResource CornerSmall}"
                                Padding="10"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="SOURCE TEXT REVIEW"
                                               Style="{DynamicResource CaptionTextStyle}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <Border Grid.Column="1" CornerRadius="3" Padding="6,2" Background="{DynamicResource TopBarBackgroundBrush}">
                                        <TextBlock Text="{Binding ReviewStatusDisplay}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                </Grid>

                                <!-- Mark Reviewed / Pending actions -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ui:Button Content="Mark Reviewed" Appearance="Primary" Command="{Binding MarkReviewedCommand}" Margin="0,0,6,0" Padding="8,3" FontSize="11" />
                                    <ui:Button Content="Mark Pending" Appearance="Secondary" Command="{Binding MarkPendingCommand}" Padding="8,3" FontSize="11" />
                                </StackPanel>

                                <!-- Raw OCR Text (Read-Only) -->
                                <TextBlock Text="Raw OCR" Style="{DynamicResource CaptionTextStyle}" />
                                <TextBox Text="{Binding RawOcrText, Mode=OneWay}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         MaxHeight="65"
                                         VerticalScrollBarVisibility="Auto"
                                         Margin="0,2,0,8"
                                         Padding="4"
                                         FontSize="12"
                                         Foreground="{DynamicResource TextSecondaryBrush}" />

                                <!-- Reviewed Text Editor (Editable) -->
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Reviewed source text" Style="{DynamicResource CaptionTextStyle}" />
                                    <TextBlock Grid.Column="1" Text="* Unsaved" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontSize="10">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReviewTextDirty}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <TextBox x:Name="ReviewedTextBox"
                                         Text="{Binding ReviewedTextDraft, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="60"
                                         MaxHeight="120"
                                         VerticalScrollBarVisibility="Auto"
                                         Margin="0,0,0,8"
                                         Padding="4"
                                         FontSize="12"
                                         PreviewKeyDown="OnReviewedTextBoxPreviewKeyDown" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ui:Button Content="Save (Ctrl+Enter)"
                                               Appearance="Primary"
                                               Command="{Binding SaveReviewedTextCommand}"
                                               IsEnabled="{Binding IsReviewTextDirty}"
                                               Margin="0,0,6,0"
                                               Padding="8,3"
                                               FontSize="11" />
                                    <ui:Button Content="Reset to OCR"
                                               Appearance="Secondary"
                                               Command="{Binding ResetReviewedTextCommand}"
                                               Padding="8,3"
                                               FontSize="11" />
                                </StackPanel>

                                <TextBlock Text="Effective source text" Style="{DynamicResource CaptionTextStyle}" />
                                <TextBlock Text="{Binding EffectiveSourceTextDisplay}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- OCR METADATA (Part M) -->
                        <Border Background="{DynamicResource CardHoverBackgroundBrush}"
                                CornerRadius="{StaticResource CornerSmall}"
                                Padding="10"
                                Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock Text="OCR DETAILS"
                                           Style="{DynamicResource CaptionTextStyle}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="No OCR data available."
                                           Foreground="{DynamicResource TextMutedBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasOcr}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasOcr}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Rec. Confidence" Style="{DynamicResource CaptionTextStyle}" />
                                            <TextBlock Text="{Binding RecognitionConfidenceDisplay}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="11" Margin="0,1,0,6" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Det. Confidence" Style="{DynamicResource CaptionTextStyle}" />
                                            <TextBlock Text="{Binding DetectionConfidenceDisplay}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="11" Margin="0,1,0,6" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Engine" Style="{DynamicResource CaptionTextStyle}" />
                                    <TextBlock Text="{Binding EngineDisplay}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="11" Margin="0,1,0,6" />
                                    <TextBlock Text="Recognition Model" Style="{DynamicResource CaptionTextStyle}" />
                                    <TextBlock Text="{Binding ModelDisplay}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="11" Margin="0,1,0,6" TextWrapping="Wrap" />
                                    <TextBlock Text="Model Profile" Style="{DynamicResource CaptionTextStyle}" />
                                    <TextBlock Text="{Binding ProfileDisplay}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="11" Margin="0,1,0,2" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Candidate Folder Inspector Panel -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedExplorerNode.IsChapterCandidate}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Chapter Candidate" Style="{DynamicResource SectionTitleTextStyle}" Margin="0,0,0,10" />
                        <TextBlock Text="This folder contains images that can be imported as a chapter."
                                   Style="{DynamicResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,14" />
                        <ui:Button Content="Import as Chapter..."
                                   Appearance="Primary"
                                   Command="{Binding ImportChapterWithFolderCommand}"
                                   CommandParameter="{Binding SelectedExplorerNode.FullPath}"
                                   HorizontalAlignment="Left" />
                    </StackPanel>

                    <!-- Loose Images in Chapters Folder Inspector Panel -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedExplorerNode.HasLooseImages}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Loose Chapter Images" Style="{DynamicResource SectionTitleTextStyle}" Margin="0,0,0,10" />
                        <TextBlock Text="Images directly inside chapters folder can be imported as a chapter."
                                   Style="{DynamicResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,14" />
                        <ui:Button Content="Import loose images..."
                                   Appearance="Primary"
                                   Command="{Binding ImportChapterWithFolderCommand}"
                                   CommandParameter="{Binding SelectedExplorerNode.FullPath}"
                                   HorizontalAlignment="Left" />
                    </StackPanel>

                    <!-- Nothing selected -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasSelectedPage}" Value="False" />
                                            <Condition Binding="{Binding HasSelectedGenericImage}" Value="False" />
                                            <Condition Binding="{Binding VisualEditor.HasSelectedRegion}" Value="False" />
                                            <Condition Binding="{Binding SelectedExplorerNode.IsChapterCandidate}" Value="False" />
                                            <Condition Binding="{Binding SelectedExplorerNode.HasLooseImages}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Nothing selected" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Select a page or image to inspect its metadata."
                                   Style="{DynamicResource CaptionTextStyle}" Margin="0,6,0,0"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <GridSplitter Grid.Row="1" Height="3" HorizontalAlignment="Stretch" ResizeDirection="Rows"
                      Visibility="{Binding IsOutputVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Grid Grid.Row="2" Height="150" Background="{DynamicResource EditorBackgroundBrush}"
              Visibility="{Binding IsOutputVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1">
                <Grid Margin="12,0,6,0">
                    <TextBlock Text="OUTPUT" Style="{DynamicResource CaptionTextStyle}"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ui:Button HorizontalAlignment="Right" Style="{DynamicResource ToolbarButtonStyle}"
                               Icon="{ui:SymbolIcon PanelBottomContract20}"
                               Command="{Binding ToggleOutputCommand}" ToolTip="Close Output" />
                </Grid>
            </Border>
            <ListBox Grid.Row="1" ItemsSource="{Binding OutputMessages}"
                     Background="Transparent" BorderThickness="0" Padding="6"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     FontFamily="Consolas" FontSize="11"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     AutomationProperties.Name="Workspace output" />
        </Grid>
    </Grid>
</UserControl>
