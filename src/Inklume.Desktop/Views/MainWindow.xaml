<ui:FluentWindow x:Class="Inklume.Desktop.Views.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:views="clr-namespace:Inklume.Desktop.Views"
                  Title="{Binding WindowTitle}"
                  Width="1440" Height="900"
                  MinWidth="1040" MinHeight="680"
                  WindowStartupLocation="CenterScreen"
                  WindowBackdropType="None"
                  ExtendsContentIntoTitleBar="True"
                  Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource TopBarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" />

        <ui:TitleBar Title=""
                     ShowHelp="False"
                     Height="46"
                     Padding="16,0,0,0"
                     Background="Transparent"
                     ButtonsBackground="Transparent"
                     ButtonsForeground="{DynamicResource TextPrimaryBrush}">
            <ui:TitleBar.Header>
                <Grid VerticalAlignment="Center">
                    <!-- Home Header: Branding only (No IDE menus) -->
                    <StackPanel Margin="8,0,0,0" Orientation="Horizontal" VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHomeVisible}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="INKLUME" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <Border Width="1" Height="14" Background="{DynamicResource BorderBrush}" Margin="14,0" />
                        <TextBlock Text="AI Comic Localization Studio" Style="{DynamicResource SecondaryTextStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Workspace Header: Discrete INKLUME Brand (Return to Home) + Menus -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWorkspaceVisible}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <ui:Button Content="INKLUME"
                                   Command="{Binding CloseProjectCommand}"
                                   ToolTip="Return to Home"
                                   Style="{DynamicResource HomeBrandButtonStyle}"
                                   Margin="0,0,2,0" />

                        <Border Width="1" Height="14"
                                Background="{DynamicResource BorderBrush}"
                                Margin="8,0,10,0"
                                VerticalAlignment="Center" />

                        <Menu Style="{DynamicResource TopMenuStyle}" VerticalAlignment="Center">
                            <ui:MenuItem Header="_File">
                                <ui:MenuItem Header="_New Project..." Command="{Binding NewProjectCommand}" />
                                <ui:MenuItem Header="_Open Project..." Command="{Binding OpenProjectCommand}" />
                                <Separator />
                                <ui:MenuItem Header="_Close Project" Command="{Binding CloseProjectCommand}" />
                                <Separator />
                                <ui:MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
                            </ui:MenuItem>
                            <ui:MenuItem Header="_View">
                                <ui:MenuItem Header="_Output"
                                             IsCheckable="True"
                                             IsChecked="{Binding Workspace.IsOutputVisible, Mode=OneWay}"
                                             Command="{Binding Workspace.ToggleOutputCommand}" />
                            </ui:MenuItem>
                            <ui:MenuItem Header="_Project">
                                <ui:MenuItem Header="Import _Chapter..." Command="{Binding Workspace.ImportChapterCommand}" />
                            </ui:MenuItem>
                            <ui:MenuItem Header="_Tools">
                                <ui:MenuItem Header="_Settings..." Command="{Binding OpenSettingsCommand}" />
                            </ui:MenuItem>
                            <ui:MenuItem Header="_Help">
                                <ui:MenuItem Header="_About INKLUME" Command="{Binding ShowAboutCommand}" />
                            </ui:MenuItem>
                        </Menu>
                    </StackPanel>
                </Grid>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <views:HomeView>
                <views:HomeView.Style>
                    <Style TargetType="views:HomeView">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHomeVisible}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:HomeView.Style>
            </views:HomeView>
            <views:WorkspaceView DataContext="{Binding Workspace}">
                <views:WorkspaceView.Style>
                    <Style TargetType="views:WorkspaceView">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsWorkspaceVisible,
                                RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:WorkspaceView.Style>
            </views:WorkspaceView>
        </Grid>

        <StatusBar Grid.Row="2">
            <StatusBarItem Margin="4,0,0,0">
                <TextBlock Text="{Binding CurrentStatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StatusBarItem>
            <StatusBarItem Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressBar Width="74" Height="2" IsIndeterminate="True" />
            </StatusBarItem>
            <StatusBarItem Visibility="{Binding IsCancellationAvailable,
                Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:Button Icon="{ui:SymbolIcon Dismiss20}"
                           Appearance="Transparent"
                           Command="{Binding CancelOperationCommand}"
                           ToolTip="Cancel current operation"
                           Padding="4,0" MinHeight="22" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right" Margin="0,0,8,0"
                           Visibility="{Binding IsWorkspaceVisible,
                           Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Icon="{ui:SymbolIcon Subtract16}"
                               Style="{DynamicResource StatusZoomButtonStyle}"
                               Command="{Binding Workspace.VisualEditor.ZoomOutCommand}"
                               ToolTip="Zoom Out" />
                    <ui:Button Content="{Binding Workspace.VisualEditor.ZoomPercentDisplay}"
                               Appearance="Transparent"
                               Command="{Binding Workspace.VisualEditor.ResetZoomCommand}"
                               ToolTip="Reset Zoom"
                               Padding="6,0" MinWidth="46" Height="22"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ui:Button Icon="{ui:SymbolIcon Add16}"
                               Style="{DynamicResource StatusZoomButtonStyle}"
                               Command="{Binding Workspace.VisualEditor.ZoomInCommand}"
                               ToolTip="Zoom In" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</ui:FluentWindow>
