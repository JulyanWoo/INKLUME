<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:Double x:Key="Space4">4</sys:Double>
    <sys:Double x:Key="Space8">8</sys:Double>
    <sys:Double x:Key="Space12">12</sys:Double>
    <sys:Double x:Key="Space16">16</sys:Double>
    <sys:Double x:Key="Space24">24</sys:Double>
    <sys:Double x:Key="Space32">32</sys:Double>
    <CornerRadius x:Key="CornerSmall">4</CornerRadius>
    <CornerRadius x:Key="CornerMedium">6</CornerRadius>
    <CornerRadius x:Key="CornerLarge">8</CornerRadius>
    <SolidColorBrush x:Key="OverlayStrokeBrush" Color="{DynamicResource AccentColor}" Opacity="0.72" />
    <SolidColorBrush x:Key="OverlayFillBrush" Color="{DynamicResource AccentColor}" Opacity="0.035" />
    <SolidColorBrush x:Key="OverlaySelectedStrokeBrush" Color="{DynamicResource AccentHoverColor}" />
    <SolidColorBrush x:Key="OverlaySelectedFillBrush" Color="{DynamicResource AccentColor}" Opacity="0.15" />
    <SolidColorBrush x:Key="OverlayLabelBackgroundBrush" Color="{DynamicResource PanelBackgroundColor}" Opacity="0.92" />
</ResourceDictionary>
