<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Colors -->
    <Color x:Key="ApplicationBackgroundColor">#16191E</Color>
    <Color x:Key="TopBarBackgroundColor">#121418</Color>
    <Color x:Key="SidebarBackgroundColor">#1A1D23</Color>
    <Color x:Key="PanelBackgroundColor">#21262E</Color>
    <Color x:Key="PanelBackgroundSecondaryColor">#282D37</Color>
    <Color x:Key="EditorBackgroundColor">#101215</Color>
    <Color x:Key="CardBackgroundColor">#222730</Color>
    <Color x:Key="CardHoverBackgroundColor">#2C333F</Color>
    <Color x:Key="SelectedBackgroundColor">#323C4C</Color>
    <Color x:Key="BorderColor">#2E3540</Color>
    <Color x:Key="BorderLightColor">#424B5A</Color>
    <Color x:Key="TextPrimaryColor">#EEF1F5</Color>
    <Color x:Key="TextSecondaryColor">#9EABB8</Color>
    <Color x:Key="TextMutedColor">#6C7786</Color>
    <Color x:Key="AccentColor">#3B82F6</Color>
    <Color x:Key="AccentHoverColor">#60A5FA</Color>
    <Color x:Key="AccentPressedColor">#2563EB</Color>
    <Color x:Key="SuccessColor">#22C55E</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="ErrorColor">#EF4444</Color>
    <Color x:Key="TransparentColor">Transparent</Color>

    <!-- Semantic Brushes -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#16191E" />
    <SolidColorBrush x:Key="TopBarBackgroundBrush" Color="#121418" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#1A1D23" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#21262E" />
    <SolidColorBrush x:Key="PanelBackgroundSecondaryBrush" Color="#282D37" />
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#101215" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#222730" />
    <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="#2C333F" />
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#323C4C" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2E3540" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="#424B5A" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EEF1F5" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9EABB8" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#6C7786" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentButtonBackground" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#60A5FA" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="ControlElevationAccentBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="SystemAccentBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />
</ResourceDictionary>
