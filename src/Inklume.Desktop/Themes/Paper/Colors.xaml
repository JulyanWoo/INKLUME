<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Colors -->
    <Color x:Key="ApplicationBackgroundColor">#F3F0EA</Color>
    <Color x:Key="TopBarBackgroundColor">#E5E1D8</Color>
    <Color x:Key="SidebarBackgroundColor">#E9E5DC</Color>
    <Color x:Key="PanelBackgroundColor">#FFFFFF</Color>
    <Color x:Key="PanelBackgroundSecondaryColor">#E2DDD3</Color>
    <Color x:Key="EditorBackgroundColor">#DDD8CE</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
    <Color x:Key="CardHoverBackgroundColor">#ECE7DD</Color>
    <Color x:Key="SelectedBackgroundColor">#D5E3F7</Color>
    <Color x:Key="BorderColor">#CFC7B9</Color>
    <Color x:Key="BorderLightColor">#B5AB9A</Color>
    <Color x:Key="TextPrimaryColor">#181B20</Color>
    <Color x:Key="TextSecondaryColor">#4E5664</Color>
    <Color x:Key="TextMutedColor">#767F8F</Color>
    <Color x:Key="AccentColor">#0969DA</Color>
    <Color x:Key="AccentHoverColor">#1F7AEA</Color>
    <Color x:Key="AccentPressedColor">#054DA6</Color>
    <Color x:Key="SuccessColor">#16A34A</Color>
    <Color x:Key="WarningColor">#D97706</Color>
    <Color x:Key="ErrorColor">#DC2626</Color>
    <Color x:Key="TransparentColor">Transparent</Color>

    <!-- Semantic Brushes -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#F3F0EA" />
    <SolidColorBrush x:Key="TopBarBackgroundBrush" Color="#E5E1D8" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#E9E5DC" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelBackgroundSecondaryBrush" Color="#E2DDD3" />
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#DDD8CE" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="#ECE7DD" />
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#D5E3F7" />
    <SolidColorBrush x:Key="BorderBrush" Color="#CFC7B9" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="#B5AB9A" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#181B20" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4E5664" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#767F8F" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0969DA" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1F7AEA" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#054DA6" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentButtonBackground" Color="#0969DA" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#1F7AEA" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#054DA6" />
    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#0969DA" />
    <SolidColorBrush x:Key="ControlElevationAccentBrush" Color="#0969DA" />
    <SolidColorBrush x:Key="SystemAccentBrush" Color="#0969DA" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />
</ResourceDictionary>
